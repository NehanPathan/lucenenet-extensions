<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOTE: build/run this project directly (e.g. `dotnet run` from this directory), not via
    Lucene.Net.Extensions.sln. It is intentionally not added to that solution. Combining a
    cross-repo ProjectReference into lucenenet with a .sln-level build breaks lucenenet's own
    internal "$(SolutionDir).build/nuget.props" import (SolutionDir gets overridden by the
    referencing solution). See the same note in Lucene.Net.Extensions.Replicator.Client.csproj.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lucene.Net.Extensions.Replicator.Client\Lucene.Net.Extensions.Replicator.Client.csproj" />
    <ProjectReference Include="..\..\src\Lucene.Net.Extensions.SelfHost.Replicator\Lucene.Net.Extensions.SelfHost.Replicator.csproj" />
    <!-- For StandardAnalyzer, used only to build the publisher's IndexWriterConfig. -->
    <ProjectReference Include="..\..\..\lucenenet\src\Lucene.Net.Analysis.Common\Lucene.Net.Analysis.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsHostingVersion)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsHttpVersion)" />
  </ItemGroup>

</Project>
